  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true, "skipLibCheck": true, "noEmit": true,
    "types": ["vite/client", "node"], "allowImportingTsExtensions": true
